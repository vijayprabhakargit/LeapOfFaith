---
import type { Edition } from "../lib/types";
import { formatDateLong } from "../lib/format";
import { buildReferenceIndex } from "../lib/references";
import Controls from "./Controls.astro";
import StoryCard from "./StoryCard.astro";
import OnThisDay from "./OnThisDay.astro";
import Extras from "./Extras.astro";
import QuizLink from "./QuizLink.astro";
import References from "./References.astro";

interface Props {
  edition: Edition;
  prevDate?: string | null;
  nextDate?: string | null;
}
const { edition, prevDate, nextDate } = Astro.props;
const stories = edition.stories;
// One numbering pass for the whole edition: superscripts and the References
// section are generated from the same index, so they cannot disagree.
const refIndex = buildReferenceIndex(stories);
---
<section class="edition-bar">
  <div class="wrap edition-bar-inner">
    <span class="eb-date">{formatDateLong(edition.date)}</span>
    <div class="eb-stats">
      <a class="eb-stat" href="/" title="Browse the stories on the home page"
        ><b>{edition.stats.stories}</b> stories</a
      >
      <a
        class="eb-stat"
        href={edition.feeds?.length ? `/editions/${edition.date}/articles/` : "/sources/"}
        title={edition.feeds?.length
          ? "See which feeds the articles came from"
          : "See the sources we read from"}
        ><b>{edition.stats.articles}</b> articles</a
      >
      <a class="eb-stat" href="/sources/" title="See the sources we read from"
        ><b>{edition.stats.feeds}</b> feeds</a
      >
      <span class="eb-nav">
        {prevDate && <a href={`/editions/${prevDate}/`}>‹ prev</a>}
        {nextDate && <a href={`/editions/${nextDate}/`}>next ›</a>}
      </span>
    </div>
  </div>
</section>

{
  edition.brief.length > 0 && (
    <div class="wrap">
      <div class="brief">
        <h2>Today's brief</h2>
        <ul>
          {edition.brief.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </div>
    </div>
  )
}

<div class="wrap">
  <QuizLink date={edition.date} />
</div>

<div class="wrap">
  <Controls edition={edition} />
  <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted); margin-bottom: 14px">
    Showing <span id="visibleCount">{stories.length}</span> of {stories.length} stories
  </div>
  <div class="stories" id="stories">
    {stories.map((s, i) => (
      <StoryCard story={s} lead={i === 0} storyIndex={i} refNumbers={refIndex.byStoryIndex.get(i)} />
    ))}
  </div>
  <p class="no-results" id="noResults" hidden>
    No stories match that. Try another section, or clear the search.
  </p>
  <OnThisDay items={edition.onThisDay} date={edition.date} />
  <Extras items={edition.extras ?? []} />
  <References entries={refIndex.entries} />
</div>

<script>
  // When arriving via a deep link, reveal what the link points at and briefly
  // flash it so it's obvious where you landed. Two kinds of links exist:
  //   #story-<slug>  a story card
  //   #cite-...      a reference superscript inside a collapsed static panel,
  //                  reached from the References section's "↩" backlinks
  function flash(el: HTMLElement, cls: string) {
    el.classList.remove(cls);
    void el.offsetWidth; // restart the animation
    el.classList.add(cls);
    window.setTimeout(() => el.classList.remove(cls), 2400);
  }

  function highlightTarget() {
    const hash = decodeURIComponent(location.hash || "");
    if (!hash) return;

    if (hash.startsWith("#story-")) {
      const el = document.getElementById(hash.slice(1));
      if (!el) return;
      el.classList.add("reveal");
      flash(el, "story-target");
      return;
    }

    if (hash.startsWith("#cite-")) {
      const cite = document.getElementById(hash.slice(1));
      if (!cite) return;
      const story = cite.closest<HTMLElement>(".story");
      const panel = cite.closest<HTMLElement>(".static-card");
      // The static panel lives in a collapsed <details>; open it so the cited
      // section is visible once we land.
      const details = cite.closest("details");
      if (details instanceof HTMLDetailsElement) details.open = true;
      if (story) {
        story.classList.add("reveal");
        flash(story, "story-target");
      }
      if (panel) flash(panel, "cite-target");
      // Land on the story so the headline tells you which article this is.
      // The open static panel below carries the highlighted citation.
      (story ?? cite).scrollIntoView({ block: "start" });
    }
  }

  highlightTarget();
  addEventListener("hashchange", highlightTarget);
</script>
