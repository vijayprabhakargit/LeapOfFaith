---
import type { Article, ExtraItem } from "../lib/types";
import { relTime } from "../lib/format";

interface Props {
  items: (ExtraItem | Article)[];
}
const { items } = Astro.props;
// Normalise: new editions store ExtraItem ({title,date,articles}); older ones
// stored a flat Article[].
const list: ExtraItem[] = items.map((it: any) =>
  it && Array.isArray(it.articles) ? it : { title: it.title, date: it.publishedAt, articles: [it] },
);
---
{
  list.length > 0 && (
    <section class="extras" id="extras">
      <div class="section-head">
        <h2>Extras</h2>
        <span class="sub">
          More from the last 24 hours — a quick skim so nothing important slips by ·{" "}
          <a
            class="extras-ext"
            href="https://news.google.com/?hl=en-IN&gl=IN&ceid=IN:en"
            target="_blank"
            rel="noopener noreferrer">Top stories on Google News ›</a
          >
        </span>
      </div>
      <ul class="extras-list">
        {list.map((it) => {
          const lead = it.articles[0];
          return (
            <li class="extras-item">
              {it.articles.length === 1 ? (
                <span class="ex-src">{lead.source}</span>
              ) : (
                <details class="ex-cluster">
                  <summary class="ex-src">{it.articles.length} sources</summary>
                  <div class="ex-links">
                    {it.articles.map((a) => (
                      <a class="ex-link" href={a.link} target="_blank" rel="noopener noreferrer">
                        {a.source}
                      </a>
                    ))}
                  </div>
                </details>
              )}
              <a class="ex-title" href={lead.link} target="_blank" rel="noopener noreferrer">
                {it.title}
              </a>
              <span class="ex-time">{relTime(it.date)}</span>
              <a
                class="gs gs-sm"
                href={`https://www.google.com/search?q=${encodeURIComponent(it.title)}`}
                target="_blank"
                rel="noopener noreferrer"
                title="Search this headline on Google"
                aria-label="Search this headline on Google"
              >
                <span>G</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
