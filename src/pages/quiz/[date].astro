---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllQuizzes, getQuiz } from "../../lib/quizzes";
import { formatDateLong, formatDateShort } from "../../lib/format";

export function getStaticPaths() {
  return getAllQuizzes().map((quiz) => ({ params: { date: quiz.date } }));
}

const { date } = Astro.params;
const quiz = getQuiz(date ?? "");
const letters = ["A", "B", "C", "D"];
---

{
  quiz ? (
    <BaseLayout
      title={`Quiz — ${formatDateShort(quiz.date)} — Leap of Faith`}
      description={`A ${quiz.questions.length}-question UPSC Prelims-style quiz drawn from the briefs of ${formatDateShort(quiz.windowStart)} to ${formatDateShort(quiz.windowEnd)}.`}
      dateline={formatDateLong(quiz.date)}
    >
      <div class="wrap">
        <div class="quiz-page">
          <header class="quiz-header">
            <p class="quiz-eyebrow">UPSC Prelims practice</p>
            <h1 class="quiz-heading">{quiz.title}</h1>
            <p class="quiz-meta">
              {quiz.questions.length} questions · {formatDateShort(quiz.windowStart)} – {formatDateShort(quiz.windowEnd)}
            </p>
            <p class="note quiz-intro">
              One correct answer per question. UPSC Prelims uses 1/3 negative marking, so the result shows both the
              raw count and the net score. The quiz is static — your answers stay in this browser session and are gone
              on reload.
            </p>
          </header>

          <form id="quiz-form" class="quiz-form">
            {quiz.questions.map((q, qi) => (
              <fieldset class="quiz-question" data-answer={q.answer} data-index={qi}>
                <legend class="quiz-legend">
                  <span class="quiz-qnum">Q{qi + 1}.</span>
                  <span class="quiz-qtext">{q.question}</span>
                </legend>
                <div class="quiz-options">
                  {q.options.map((opt, oi) => (
                    <label class="quiz-option">
                      <input type="radio" name={`q${qi}`} value={oi} />
                      <span class="quiz-option-letter">{letters[oi]}</span>
                      <span class="quiz-option-text">{opt}</span>
                    </label>
                  ))}
                </div>
                <div class="quiz-explanation" hidden>
                  <p>
                    <strong>Answer: {letters[q.answer]}.</strong> {q.explanation}
                  </p>
                </div>
                <p class="quiz-topic">Topic: {q.topic}</p>
              </fieldset>
            ))}

            <div class="quiz-actions">
              <button type="submit" class="btn primary">Submit answers</button>
              <button type="button" class="btn" id="quiz-retake">Retake</button>
            </div>

            <div class="quiz-result" id="quiz-result" hidden></div>
          </form>

          <p class="note quiz-back">
            <a href="/quiz/">All quizzes ›</a> · <a href={`/editions/${quiz.date}/`}>Read the edition ›</a>
          </p>
        </div>
      </div>
    </BaseLayout>
  ) : (
    <BaseLayout title="Quiz not found">
      <div class="wrap">
        <div class="empty">
          <p>That quiz is not available.</p>
          <p>
            <a href="/quiz/">Browse all quizzes ›</a>
          </p>
        </div>
      </div>
    </BaseLayout>
  )
}

<script>
  const form = document.getElementById("quiz-form") as HTMLFormElement | null;
  const result = document.getElementById("quiz-result") as HTMLDivElement | null;
  const retake = document.getElementById("quiz-retake") as HTMLButtonElement | null;
  const questions = form ? [...form.querySelectorAll<HTMLFieldSetElement>(".quiz-question")] : [];

  function clearState() {
    for (const q of questions) {
      q.classList.remove("quiz-answered");
      for (const opt of q.querySelectorAll<HTMLElement>(".quiz-option")) {
        opt.classList.remove("quiz-correct", "quiz-wrong");
      }
      const explanation = q.querySelector<HTMLElement>(".quiz-explanation");
      if (explanation) explanation.hidden = true;
    }
    if (result) {
      result.hidden = true;
      result.innerHTML = "";
    }
  }

  function scoreLabel(correct: number, wrong: number, unanswered: number, total: number) {
    const net = correct - wrong / 3;
    const pct = total ? Math.round((correct / total) * 100) : 0;
    let message = "Keep revising — read the explanations and retake.";
    if (pct >= 80) message = "Excellent — that is exam-ready recall.";
    else if (pct >= 60) message = "Good — a little more revision on the misses.";
    else if (pct >= 40) message = "Solid start — the explanations are your revision list.";
    return `<div class="quiz-score-line"><span class="quiz-score">${correct} / ${total}</span><span class="quiz-score-sub">correct</span></div>
      <p class="quiz-score-detail">Wrong: ${wrong} · Unanswered: ${unanswered} · Net score (1/3 negative): <strong>${net.toFixed(2)} / ${total}</strong></p>
      <p class="quiz-score-message">${message}</p>`;
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    clearState();
    let correct = 0;
    let wrong = 0;
    let unanswered = 0;

    for (const q of questions) {
      const answer = Number(q.dataset.answer);
      const options = [...q.querySelectorAll<HTMLElement>(".quiz-option")];
      const chosen = q.querySelector<HTMLInputElement>("input[type=radio]:checked");
      const explanation = q.querySelector<HTMLElement>(".quiz-explanation");

      options.forEach((opt, i) => {
        if (i === answer) opt.classList.add("quiz-correct");
      });

      if (!chosen) {
        unanswered++;
      } else {
        const picked = Number(chosen.value);
        if (picked === answer) {
          correct++;
        } else {
          wrong++;
          options[picked]?.classList.add("quiz-wrong");
        }
      }

      q.classList.add("quiz-answered");
      if (explanation) explanation.hidden = false;
    }

    if (result) {
      result.innerHTML = scoreLabel(correct, wrong, unanswered, questions.length);
      result.hidden = false;
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  });

  retake?.addEventListener("click", () => {
    form?.reset();
    clearState();
    document.querySelector(".quiz-header")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>
