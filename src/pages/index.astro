---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditionView from "../components/EditionView.astro";
import { getLatestEdition, getEditionDates } from "../lib/editions";
import { getLatestQuiz } from "../lib/quizzes";
import { formatDateLong } from "../lib/format";

const edition = getLatestEdition();
const dates = getEditionDates();
const prevDate = edition && dates.length > 1 ? dates[1] : null;
const quiz = getLatestQuiz();
---
<BaseLayout
  title={edition ? `Leap of Faith — The Daily Brief — ${edition.date}` : "Leap of Faith — The Daily Brief"}
  dateline={edition ? edition.date : ""}
>
  <Fragment slot="head">
    <meta name="edition-date" content={edition?.date ?? ""} />
    <script is:inline>
      // The site is static, so "today" advances at midnight with no rebuild. If
      // the newest edition isn't dated today (IST), show the "on the way" panel
      // instead of passing off yesterday's edition as today's. Runs in <head> so
      // no stale edition flashes on first paint.
      (function () {
        try {
          var meta = document.querySelector('meta[name="edition-date"]');
          var date = meta && meta.getAttribute("content");
          if (!date) return;
          var today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Kolkata" }).format(new Date());
          if (date !== today) document.documentElement.classList.add("edition-pending");
        } catch (e) {
          /* fail open: show the latest edition */
        }
      })();
    </script>
  </Fragment>

  <div id="edition-root">
    {
      edition ? (
        <EditionView edition={edition} prevDate={prevDate} nextDate={null} />
      ) : (
        <div class="wrap">
          <div class="empty">
            <h2>No edition yet</h2>
            <p class="note" style="margin: 12px auto 18px">
              The first brief hasn't been published yet. Editions usually land around 07:00 IST, though the
              first run can take a little longer — check back soon.
            </p>
            <p>
              <a class="btn" href="/sources/">Browse the sources</a>
            </p>
          </div>
        </div>
      )
    }
  </div>

  <div id="today-pending" class="wrap">
    <div class="empty">
      <h2>Today's edition is on the way</h2>
      <p class="note" style="margin: 12px auto 18px">
        This morning's brief usually lands around 07:00 IST. It can run a little late — but it's still
        coming today.
      </p>
      {
        quiz && (
          <p class="note" style="margin: 0 auto 12px">
            While you wait, take the latest Prelims quiz — {quiz.questions.length} questions from the
            last week of briefs.
          </p>
        )
      }
      <p class="pending-actions">
        {quiz && (
          <a class="btn primary" href={`/quiz/${quiz.date}/`}>
            Take the {formatDateLong(quiz.date)} quiz
          </a>
        )}
        {quiz && <a class="btn" href="/quiz/">All quizzes</a>}
      </p>
      {
        edition && (
          <div class="pending-latest">
            <p class="pending-latest-head">Catch up on the latest edition · {formatDateLong(edition.date)}</p>
            <ul class="pending-latest-list">
              {edition.stories.slice(0, 3).map((story) => (
                <li>
                  <a href={`/editions/${edition.date}/`}>{story.headline}</a>
                </li>
              ))}
            </ul>
            <p style="margin: 12px 0 0">
              <a class="btn" href={`/editions/${edition.date}/`}>
                Read the full edition
              </a>
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
