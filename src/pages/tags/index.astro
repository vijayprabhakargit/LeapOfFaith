---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagIndex } from "../../lib/tags";

const index = getTagIndex();
const maxAll = Math.max(1, ...index.map((t) => t.count));

function monthsOf(stories: { date: string }[]) {
  const months: Record<string, number> = {};
  for (const s of stories) {
    const k = s.date.slice(0, 7);
    months[k] = (months[k] ?? 0) + 1;
  }
  return months;
}

// Compact payload embedded in the page; the browser filters it locally.
const payload = {
  tags: index.map((t) => ({
    slug: t.slug,
    label: t.tag,
    months: monthsOf(t.stories),
    stories: t.stories.map((s) => ({ date: s.date, slug: s.slug, headline: s.headline })),
  })),
};

function sizeClass(count: number, max: number): string {
  const r = count / max;
  if (r > 0.75) return "t5";
  if (r > 0.5) return "t4";
  if (r > 0.35) return "t3";
  if (r > 0.15) return "t2";
  return "t1";
}
---
<BaseLayout title="Tags — Leap of Faith" description="Browse every story by tag across the editions of The Daily Brief.">
  <div class="wrap">
    <div class="archive-page">
      <header class="archive-header">
        <h1 class="archive-heading">Tags</h1>
        <span class="archive-count">{index.length} tag{index.length === 1 ? "" : "s"}</span>
      </header>
      <hr class="archive-rule-thin" />

      {
        index.length === 0 && (
          <div class="empty">
            <h2>No tags yet</h2>
            <p class="note">Tags appear here once editions are generated.</p>
          </div>
        )
      }

      <div class="tag-toolbar">
        <label for="tag-range">Show</label>
        <select id="tag-range" class="tag-select">
          <option value="all">All time</option>
          <option value="1">Last 1 month</option>
          <option value="3">Last 3 months</option>
          <option value="6">Last 6 months</option>
          <option value="12">Last 12 months</option>
          <option value="custom">Custom…</option>
        </select>
        <div class="tag-custom" id="tag-custom" hidden>
          <input type="date" id="tag-from" class="tag-date" aria-label="From date" />
          <span class="tag-dash">–</span>
          <input type="date" id="tag-to" class="tag-date" aria-label="To date" />
        </div>
      </div>

      <div class="tag-cloud" id="tag-cloud">
        {
          index.map((t) => (
            <a
              class:list={["tag-cloud-item", sizeClass(t.count, maxAll)]}
              href={`?tag=${t.slug}`}
              data-tag={t.slug}
              title={`${t.count} stor${t.count === 1 ? "y" : "ies"}`}
            >
              {t.tag}
              <span class="tc-count">{t.count}</span>
            </a>
          ))
        }
      </div>

      <div class="tag-view" id="tag-view" hidden>
        <div class="tag-active">
          <span class="tag-active-label" id="tag-active-label"></span>
          <a class="tag-clear" id="tag-clear" href="/tags/">Clear ×</a>
        </div>
        <ul class="tag-story-list" id="tag-stories"></ul>
        <p class="tag-empty" id="tag-empty" hidden>No stories in this range.</p>
      </div>
    </div>
  </div>

  <script type="application/json" id="tag-data" is:inline set:html={JSON.stringify(payload)}></script>

  <script>
    const dataEl = document.getElementById("tag-data");
    const data = dataEl ? JSON.parse(dataEl.textContent || '{"tags":[]}') : { tags: [] };
    const tags = data.tags || [];

    const cloud = document.getElementById("tag-cloud");
    const rangeEl = document.getElementById("tag-range") as HTMLSelectElement | null;
    const customEl = document.getElementById("tag-custom");
    const fromEl = document.getElementById("tag-from") as HTMLInputElement | null;
    const toEl = document.getElementById("tag-to") as HTMLInputElement | null;
    const viewEl = document.getElementById("tag-view");
    const activeLabel = document.getElementById("tag-active-label");
    const listEl = document.getElementById("tag-stories");
    const emptyEl = document.getElementById("tag-empty");
    const clearEl = document.getElementById("tag-clear");

    let selected: string | null = null;

    function bounds() {
      const range = rangeEl?.value || "all";
      if (range === "all") return { from: null as string | null, to: null as string | null };
      if (range === "custom") return { from: fromEl?.value || null, to: toEl?.value || null };
      const d = new Date();
      d.setMonth(d.getMonth() - parseInt(range, 10));
      return { from: d.toISOString().slice(0, 10), to: null };
    }

    function inRange(date: string, from: string | null, to: string | null) {
      if (from && date < from) return false;
      if (to && date > to) return false;
      return true;
    }

    function sizeClass(count: number, max: number) {
      const r = count / max;
      if (r > 0.75) return "t5";
      if (r > 0.5) return "t4";
      if (r > 0.35) return "t3";
      if (r > 0.15) return "t2";
      return "t1";
    }

    function esc(s: string) {
      return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string);
    }
    function fmtDate(iso: string) {
      return new Date(`${iso}T06:00:00+05:30`).toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });
    }

    function render() {
      if (!cloud) return;
      const { from, to } = bounds();
      const visible = tags
        .map((t: any) => ({ t, c: t.stories.filter((s: any) => inRange(s.date, from, to)).length }))
        .filter((x: any) => x.c > 0)
        .sort((a: any, b: any) => b.c - a.c || a.t.label.localeCompare(b.t.label));
      const max = Math.max(1, ...visible.map((x: any) => x.c));

      cloud.innerHTML = "";
      if (!visible.length) {
        cloud.innerHTML = '<p class="tag-empty">No tags in this range.</p>';
      }
      for (const { t, c } of visible) {
        const a = document.createElement("a");
        a.className = `tag-cloud-item ${sizeClass(c, max)}`;
        a.href = `?tag=${encodeURIComponent(t.slug)}`;
        a.dataset.tag = t.slug;
        a.title = `${c} stor${c === 1 ? "y" : "ies"}`;
        a.innerHTML = `${esc(t.label)}<span class="tc-count">${c}</span>`;
        cloud.appendChild(a);
      }

      const tag = tags.find((t: any) => t.slug === selected);
      if (tag && viewEl && listEl) {
        viewEl.hidden = false;
        if (activeLabel) activeLabel.textContent = tag.label;
        listEl.innerHTML = "";
        const stories = tag.stories.filter((s: any) => inRange(s.date, from, to));
        for (const s of stories) {
          const li = document.createElement("li");
          li.innerHTML =
            `<a class="tsl-link" href="/editions/${s.date}/#story-${s.slug}">` +
            `<span class="tsl-date">${fmtDate(s.date)}</span>` +
            `<span class="tsl-headline">${esc(s.headline)}</span></a>`;
          listEl.appendChild(li);
        }
        if (emptyEl) emptyEl.hidden = stories.length !== 0;
      } else if (viewEl) {
        viewEl.hidden = true;
      }
    }

    function syncUrl() {
      const p = new URLSearchParams();
      if (selected) p.set("tag", selected);
      const range = rangeEl?.value;
      if (range && range !== "all") p.set("range", range);
      if (range === "custom") {
        if (fromEl?.value) p.set("from", fromEl.value);
        if (toEl?.value) p.set("to", toEl.value);
      }
      const qs = p.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    }

    function readUrl() {
      const p = new URLSearchParams(location.search);
      selected = p.get("tag");
      const r = p.get("range");
      const f = p.get("from");
      const t = p.get("to");
      if (rangeEl && r) rangeEl.value = r;
      if (fromEl && f) fromEl.value = f;
      if (toEl && t) toEl.value = t;
      if (customEl) customEl.hidden = rangeEl?.value !== "custom";
    }

    rangeEl?.addEventListener("change", () => {
      if (customEl) customEl.hidden = rangeEl.value !== "custom";
      syncUrl();
      render();
    });
    fromEl?.addEventListener("change", () => {
      syncUrl();
      render();
    });
    toEl?.addEventListener("change", () => {
      syncUrl();
      render();
    });

    cloud?.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest(".tag-cloud-item") as HTMLElement | null;
      if (!a) return;
      e.preventDefault();
      selected = a.dataset.tag || null;
      syncUrl();
      render();
    });
    clearEl?.addEventListener("click", (e) => {
      e.preventDefault();
      selected = null;
      syncUrl();
      render();
    });

    readUrl();
    render();
  </script>
</BaseLayout>
