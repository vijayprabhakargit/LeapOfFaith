---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagIndex } from "../../lib/tags";
import { formatDateShort } from "../../lib/format";

export function getStaticPaths() {
  return getTagIndex().map((entry) => ({ params: { tag: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---
<BaseLayout
  title={`${entry.tag} — Tags — Leap of Faith`}
  description={`Every story tagged ${entry.tag} across the editions of The Daily Brief.`}
>
  <div class="wrap">
    <div class="archive-page">
      <header class="archive-header">
        <h1 class="archive-heading">{entry.tag}</h1>
        <span class="archive-count">{entry.count} stor{entry.count === 1 ? "y" : "ies"}</span>
      </header>
      <hr class="archive-rule-thin" />
      <p class="tag-back"><a href="/tags/">‹ All tags</a></p>
      <ul class="tag-story-list">
        {
          entry.stories.map((s) => (
            <li>
              <a class="tsl-link" href={`/editions/${s.date}/#story-${s.slug}`}>
                <span class="tsl-date">{formatDateShort(s.date)}</span>
                <span class="tsl-headline">{s.headline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
