# Leap of Faith — The Daily Brief: environment variables
# Copy to `.env` and fill in. `.env` is git-ignored.
#
# ── LLM (pick ONE provider) ───────────────────────────────────────────────
# provider: openai | anthropic | gemini | openrouter | compatible
#
# Chosen setup for the daily job (OpenRouter → DeepSeek V4.1 Flash):
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_API_KEY=

# Providers also accept their own conventional key var if LLM_API_KEY is unset:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Only for a self-hosted OpenAI-compatible server (Ollama, vLLM, LM Studio…):
# LLM_BASE_URL=http://localhost:11434/v1

# ── Deployment (only needed locally for `npm run deploy`) ─────────────────
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
